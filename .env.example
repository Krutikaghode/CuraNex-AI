# Copy to .env for local (non-Docker) runs. All variables are optional.
CURANEX_ENVIRONMENT=development
CURANEX_DATABASE_URL=sqlite:///./data/curanex.db
CURANEX_DATA_DIR=./data

# Frontend -> API
CURANEX_API_URL=http://127.0.0.1:8000

# Assistant: ollama (local LLM) | fake (offline demo, extractive answers, no model needed)
CURANEX_LLM_PROVIDER=ollama
CURANEX_OLLAMA_BASE_URL=http://localhost:11434
CURANEX_OLLAMA_MODEL=llama3.1:8b
CURANEX_OLLAMA_EMBED_MODEL=nomic-embed-text
CURANEX_RAG_TOP_K=5
CURANEX_RAG_MIN_SCORE=0.0

# docker-compose only
POSTGRES_PASSWORD=change-me
